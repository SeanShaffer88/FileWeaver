import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export struct PreviewRow {
    old_name: string,
    proposed_name: string,
    state: string,
}

export struct LedgerRow {
    heading: string,
    detail: string,
}

export component MainWindow inherits Window {
    title: "FileWeaver";
    width: 1120px;
    height: 920px;

    in-out property <string> folder_path: "";
    in-out property <string> prefix: "";
    in-out property <string> find_text: "";
    in-out property <string> replace_text: "";
    in-out property <bool> add_counter: false;
    in-out property <bool> recursive: false;
    in-out property <bool> can_apply: false;
    in-out property <bool> applying: false;
    in-out property <int> sort_index: 0;
    in-out property <string> risk_budget: "";
    in-out property <string> order_summary: "";
    in-out property <string> status: "Choose a folder or paste its path, then select Scan to create a safe preview.";
    in-out property <[PreviewRow]> rows: [];
    in-out property <int> selected_row_index: -1;
    in-out property <string> provenance: "";
    in-out property <[LedgerRow]> ledger_rows: [];
    in-out property <int> selected_job_index: -1;
    in-out property <string> ledger_detail: "Select Refresh history to load recorded jobs.";
    in-out property <bool> can_rollback: false;
    in-out property <bool> confirming_rollback: false;

    callback scan_folder(string);
    callback refresh_preview();
    callback apply_changes();
    callback stop_apply();
    callback inputs_changed();
    callback refresh_ledger();
    callback select_job(int);
    callback rollback_selected();
    callback select_row(int);

    background: #f7f8fa;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "FileWeaver";
            font-size: 26px;
            font-weight: 700;
            color: #172033;
        }
        Text {
            text: "Preview, explain, and recover batch file changes locally.";
            color: #4a5568;
        }

        Rectangle {
            background: #ffffff;
            border-color: #cbd5e1;
            border-width: 1px;
            border-radius: 8px;
            height: 92px;
            HorizontalLayout {
                padding: 14px;
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    Text { text: "Folder to scan"; font-weight: 600; color: #172033; }
                    LineEdit {
                        text <=> root.folder_path;
                        placeholder-text: "C:\\Users\\you\\Pictures";
                        edited => { root.inputs_changed(); }
                        accessible-label: "Folder to scan";
                        accessible-description: "Paste a folder path. The app scans it locally and does not change files until you apply a reviewed plan.";
                    }
                }
                VerticalLayout {
                    alignment: end;
                    CheckBox {
                        text: "Include subfolders";
                        checked <=> root.recursive;
                        toggled => { root.inputs_changed(); }
                        accessible-description: "Include files in child folders. Leave this unchecked to review only the selected folder.";
                    }
                    Button {
                        text: "Scan folder";
                        primary: true;
                        clicked => { root.scan_folder(root.folder_path); }
                        accessible-description: "Create a non-destructive preview of files in the folder.";
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            Rectangle {
                width: 318px;
                background: #ffffff;
                border-color: #cbd5e1;
                border-width: 1px;
                border-radius: 8px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: "Build rules"; font-size: 18px; font-weight: 700; color: #172033; }
                    Text { text: "Rules are applied in this order. The preview updates only when you select Refresh preview."; wrap: word-wrap; color: #4a5568; }
                    Text { text: "Add prefix"; font-weight: 600; }
                    LineEdit {
                        text <=> root.prefix;
                        placeholder-text: "Example: 2026-";
                        edited => { root.inputs_changed(); }
                        accessible-label: "Add prefix";
                        accessible-description: "Adds this text before every proposed filename.";
                    }
                    Text { text: "Find"; font-weight: 600; }
                    LineEdit {
                        text <=> root.find_text;
                        placeholder-text: "Text to replace";
                        edited => { root.inputs_changed(); }
                        accessible-label: "Find text";
                        accessible-description: "Find literal text in each filename. Leave blank to make no replacement.";
                    }
                    Text { text: "Replace with"; font-weight: 600; }
                    LineEdit {
                        text <=> root.replace_text;
                        placeholder-text: "Replacement text";
                        edited => { root.inputs_changed(); }
                        accessible-label: "Replacement text";
                        accessible-description: "Replacement for the Find text. An empty value removes matching text.";
                    }
                    Text { text: "Numbering order"; font-weight: 600; }
                    ComboBox {
                        model: ["Path (A–Z)", "Name (A–Z)", "Modified (oldest first)", "Capture date (oldest first)"];
                        current-index <=> root.sort_index;
                        selected => { root.inputs_changed(); }
                        accessible-label: "Numbering order";
                        accessible-description: "The order files are numbered and processed in. Capture date uses JPEG Exif capture time; files without one go last.";
                    }
                    CheckBox {
                        text: "Append stable counter";
                        checked <=> root.add_counter;
                        toggled => { root.inputs_changed(); }
                        accessible-description: "Append a four-digit number before the extension, assigned in the numbering order selected above.";
                    }
                    Button {
                        text: "Refresh preview";
                        clicked => { root.refresh_preview(); }
                        accessible-description: "Recalculate the proposed names without changing files.";
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Advanced rules"; font-weight: 700; color: #172033; }
                    Text { text: "Regex and capture-date rules exist in the core library but are not exposed in this first UI slice. Saved templates and mapping imports are not implemented yet."; wrap: word-wrap; color: #4a5568; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                border-color: #cbd5e1;
                border-width: 1px;
                border-radius: 8px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "Preview"; font-size: 18px; font-weight: 700; color: #172033; }
                    Text {
                        text: root.risk_budget;
                        wrap: word-wrap;
                        color: #334155;
                        accessible-label: "Risk summary";
                    }
                    Text {
                        text: root.order_summary;
                        wrap: word-wrap;
                        color: #334155;
                        accessible-label: "Order summary";
                    }
                    HorizontalLayout {
                        Text { text: "Current name"; font-weight: 700; horizontal-stretch: 1; color: #334155; }
                        Text { text: "Proposed name"; font-weight: 700; horizontal-stretch: 1; color: #334155; }
                        Text { text: "Status"; width: 150px; font-weight: 700; color: #334155; }
                    }
                    Rectangle { height: 1px; background: #dbe3ee; }
                    ScrollView {
                        vertical-stretch: 1;
                        for row[idx] in root.rows : Rectangle {
                            height: 30px;
                            background: idx == root.selected_row_index ? #e2e8f0 : transparent;
                            TouchArea { clicked => { root.select_row(idx); } }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: row.old_name; horizontal-stretch: 1; overflow: elide; }
                                Text { text: row.proposed_name; horizontal-stretch: 1; overflow: elide; color: #0f5132; }
                                Text { text: row.state; width: 150px; overflow: elide; color: #334155; }
                            }
                        }
                    }
                    Text {
                        text: root.provenance;
                        wrap: word-wrap;
                        color: #334155;
                        accessible-label: "How the selected name was built";
                    }
                    Text {
                        text: root.status;
                        wrap: word-wrap;
                        color: #334155;
                        accessible-label: "Status";
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-color: #cbd5e1;
            border-width: 1px;
            border-radius: 8px;
            height: 196px;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Recovery ledger"; font-size: 18px; font-weight: 700; color: #172033; horizontal-stretch: 1; }
                    Button {
                        text: "Refresh history";
                        clicked => { root.refresh_ledger(); }
                        accessible-description: "Reload the list of recorded jobs from the local operation ledger.";
                    }
                }
                ScrollView {
                    height: 62px;
                    VerticalLayout {
                        for row[idx] in root.ledger_rows : Rectangle {
                            height: 30px;
                            background: idx == root.selected_job_index ? #e2e8f0 : transparent;
                            TouchArea { clicked => { root.select_job(idx); } }
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 10px;
                                Text { text: row.heading; font-weight: 600; color: #172033; }
                                Text { text: row.detail; color: #4a5568; horizontal-stretch: 1; overflow: elide; }
                            }
                        }
                    }
                }
                Text {
                    text: root.ledger_detail;
                    wrap: word-wrap;
                    color: #334155;
                    accessible-label: "Recovery review";
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: root.confirming_rollback ? "Click again to confirm rollback" : "Roll back selected job";
                        enabled: root.can_rollback && !root.applying;
                        clicked => { root.rollback_selected(); }
                        accessible-description: "Reverse the selected job for files that are unchanged since it ran. Changed or missing files are never overwritten.";
                    }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            border-color: #cbd5e1;
            border-width: 1px;
            border-radius: 8px;
            height: 68px;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    text: "Files are never changed by Scan or Refresh preview. Apply is enabled only when the plan has no blocking errors.";
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    color: #334155;
                }
                Button {
                    text: "Stop";
                    enabled: root.applying;
                    clicked => { root.stop_apply(); }
                    accessible-description: "Stop the current job safely. The file in progress finishes, completed changes stay recorded in the operation ledger, and nothing further is changed.";
                }
                Button {
                    text: "Apply reviewed changes";
                    primary: true;
                    enabled: root.can_apply && !root.applying;
                    clicked => { root.apply_changes(); }
                    accessible-description: "Apply the reviewed plan. A durable local operation ledger records each completed file for later rollback.";
                }
            }
        }
    }
}
